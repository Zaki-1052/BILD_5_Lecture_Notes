coord_cartesian(ylim=c(800,1150),xlim=c(18,36)) + #setting limits for x and y
theme(axis.text=element_text(size=12)) + #increasing axes title sizes
xlab("Shower Temperature") + #x-axis label
ylab("Immune Response") + #y-axis label
geom_point(size=2) + #increasing size of the points
geom_smooth(method = lm,color="navy",fill="blue") #trend line of the linear model
plot1
