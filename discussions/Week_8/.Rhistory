library(tidyverse)
BrainData<-read.csv(file = "Week8Brains.csv")
head(BrainData)
### This chunk of code is for grading purposes.
### Don't change/delete this chunk of code.
q1 <- BrainData
#visualize the second language scores data here.
Histogram1<-ggplot(data = BrainData, mapping = aes(x=Second.language.proficiency)) +
geom_histogram()
Histogram1
#Test for normality of the second language scores in this code box.
ks.test(BrainData$Second.language.proficiency,"pnorm",mean(BrainData$Second.language.proficiency),sd(BrainData$Second.language.proficiency))
#visualize the gray matter density data here.
Histogram2<-ggplot(data = BrainData, mapping = aes(x=Gray.matter.density)) +
geom_histogram()
Histogram2
#Test for normality of the gray matter density data in this code box.
ks.test(BrainData$Gray.matter.density,"pnorm",mean(BrainData$Gray.matter.density),sd(BrainData$Gray.matter.density))
### This chunk of code is for grading purposes.
### Don't change/delete this chunk of code.
q2 <- Histogram1
q3 <- Histogram2
q4 <- "TRUE"
q5 <- "TRUE"
NullHypothesis<-"There is no change or difference in brain structure between individuals who learn a second language and those who do not."
print(NullHypothesis)
AlternateHypothesis<-"There is a difference in brain structure between individuals who learn a second language and those who do not."
print(AlternateHypothesis)
### This chunk of code is for grading purposes.
### Don't change/delete this chunk of code.
q6 <- NullHypothesis
q7 <- AlternateHypothesis
#Build your linear model in this code block
q8 <- lm(Gray.matter.density ~ Second.language.proficiency, data = BrainData)
q8
q9 <- "Gray.matter.density = -0.07214 + 0.03024(Second.language.proficiency)"
#test your linear model in this code block
q10 <-summary(q8)
q10
q11 <-  0.030235  #Slope value before the hashtag
q12 <-  0.004749  #Standard error of the slope before the hashtag
q13 <-  3.26e-06  #Correct p value before the hashtag
q14 <-  0.6696  #R^2 before the hashtag
plot1<-ggplot(data=BrainData,mapping=aes(x=Second.language.proficiency,y=Gray.matter.density))+
theme_classic() +
theme(axis.text=element_text(size=12)) +
xlab("Proficiency in second language") +
ylab("Gray-matter density") +
geom_point(size=2.5) +
geom_smooth(method = "lm",color="navy",fill="blue")
plot1
