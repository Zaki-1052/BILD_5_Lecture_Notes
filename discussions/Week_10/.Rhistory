#USE THIS BLOCK TO INPUT NECESSARY CODE.
plot1<-ggplot(data=data,mapping=aes(x=showerTemperature,y=immuneResponse))+
theme_classic() +
coord_cartesian(ylim=c(800,1150),xlim=c(18,36)) +
theme(axis.text=element_text(size=12)) +
xlab("Shower Temperature") +
ylab("Immune Response") +
geom_point(size=2) +
geom_smooth(method = lm,color="navy",fill="blue")
plot1
